# Все остальные настройки (включение/отключение фич, токен Telegram-бота, автовыполнение квестов,
# стейкинг, промокоды и т.д.) задаются на странице "Настройки" веб-панели после запуска бота —
# они хранятся в config/settings.json, а не в переменных окружения.
WEB_PORT=3000
# Интерфейс прослушивания веб-панели. По умолчанию 127.0.0.1 (только локально).
# В Docker задаётся 0.0.0.0 в docker-compose.yml (иначе публикация порта не работает).
# Для bare-metal с доступом по сети поставьте 0.0.0.0 и ОБЯЗАТЕЛЬНО задайте пароль в Настройках.
WEB_BIND=127.0.0.1
DB_HOST=localhost
DB_EXPOSED_PORT=3377
DB_USER=root
DB_PASSWORD=change_me
DB_NAME=db_main

# Префикс имён контейнеров. Нужен, только если на одном хосте поднимается НЕСКОЛЬКО экземпляров
# бота: у второго задайте свой STACK_NAME и свои WEB_PORT/DB_EXPOSED_PORT, иначе Docker откажет
# («container name is already in use»), а порты займёт первый экземпляр.
STACK_NAME=toncity

# Ключ доступа к toncityquests.ru (отправка гильд-квестов на внешний сайт). Пусто — функция выключена.
TONCITYQUESTS_BOT_HASH=
